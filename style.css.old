/* Base styles */
* {
    font-family: "Roboto", "DejaVu Sans", "Helvetica", Arial, sans-serif;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    color: #333;
    line-height: 1.3;
    background: #f5f5f5;
}

.resume-container {
    background: white;
    padding: 30px 40px;
    box-shadow: 0 1px 5px rgba(0,0,0,0.1);
    margin: 0 auto;
    max-width: 800px;
}

/* Resume Structure */
.resume-section {
    margin-bottom: 15px;
    clear: both;
}

.section-content {
    padding-left: 4px;
}

.resume-section h2 {
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid #333;
    padding-bottom: 4px;
    margin-bottom: 8px;
}

/* Header Section */
.header-section {
    text-align: center;
    margin-bottom: 18px;
}

.header-section h1 {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 7px;
    letter-spacing: 0.5px;
}

.contact-info {
    font-size: 12px;
    margin-bottom: 4px;
}

.contact-info a {
    color: #333;
    text-decoration: none;
}

/* Summary Section */
.summary-section p {
    font-size: 12px;
    text-align: justify;
    margin-bottom: 4px;
    line-height: 1.4;
}

/* Education Entries */
.education-entry {
    margin-bottom: 8px;
}

.education-entry p {
    font-size: 12px;
    margin-bottom: 4px;
    line-height: 1.4;
}

.degree {
    font-weight: bold;
}

/* Skills List */
.skills-container p {
    font-size: 12px;
    margin-bottom: 4px;
    line-height: 1.4;
}

.skill-category {
    font-weight: bold;
    display: inline-block;
    min-width: 100px;
    vertical-align: top;
}

.skill-list {
    display: inline-block;
    vertical-align: top;
}

/* Experience Section */
.experience-entry {
    margin-bottom: 12px;
}

.job-header p {
    font-size: 12px;
    margin-bottom: 4px;
}

.job-title {
    font-weight: bold;
}

.job-accomplishments {
    list-style-type: disc;
    margin-left: 20px;
    margin-top: 3px;
    margin-bottom: 6px;
}

.job-accomplishments li {
    font-size: 12px;
    margin-bottom: 3px;
    line-height: 1.4;
    padding-left: 4px;
}

/* Projects Section */
.project-entry {
    margin-bottom: 10px;
}

.project-entry p {
    font-size: 12px;
    margin-bottom: 4px;
    line-height: 1.4;
}

.project-title {
    font-weight: bold;
}

.project-description {
    padding-left: 4px;
}

/* Preview Banner */
.bg-light {
    background-color: #f8f9fa !important;
}

.py-2 {
    padding-top: 0.5rem !important;
    padding-bottom: 0.5rem !important;
}

.mb-4 {
    margin-bottom: 1.5rem !important;
}

/* Navigation */
.navbar {
    margin-bottom: 0 !important;
}

/* Print styles */
@media print {
    body {
        background: white;
        padding: 0;
    }

    .navbar, 
    .preview-banner,
    .action-buttons,
    .footer {
        display: none !important;
    }

    .resume-container {
        box-shadow: none;
        padding: 20px;
        max-width: none;
    }
}
